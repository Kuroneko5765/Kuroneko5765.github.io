#header
  height: 800px /* 头图高度，可自行调整 */
  position: relative
  border-bottom: 1px solid color-border
  overflow: hidden /* 防止头图放大时溢出 */
  
  &:before, &:after
    content: ""
    position: absolute
    left: 0
    right: 0
    height: 40px
    z-index: 3 /* 确保渐变层在图片上方 */
    pointer-events: none /* 让鼠标穿透遮罩层，不挡点击 */
    
  &:before
    top: 0
    background: linear-gradient(rgba(0, 0, 0, 0.2), transparent)
  &:after
    bottom: 0
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.2))

  &:hover
    #header-title
      opacity: 0 /* 仅隐藏标题 */
    #banner
      filter: blur(0px)
      transform: scale(1.01)

#header-outer
  height: 100%
  position: relative
  z-index: 2
  pointer-events: none /* 让鼠标穿透空白区域，直接触碰到底下的头图 */

/* 恢复链接和搜索框的鼠标点击功能 */
#header-outer a, 
#search-form-wrap
  pointer-events: auto

#header-inner
  position: relative
  overflow: hidden

#banner
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: url("/images/banner-yu.jpeg") center #000
  background-size: cover
  z-index: 1
  filter: blur(5px)
  transform: scale(1.05)
  transition: filter 0.5s ease, transform 0.5s ease

#header-title
  text-align: center
  height: logo-size
  position: absolute
  top: 10%
  left: 0
  width: 100%
  margin-top: logo-size * -0.5
  opacity: 1 /* 默认完全不透明 */
  transition: opacity 0.5s ease

$logo-text
  text-decoration: none
  color: #300000
  font-weight: 350
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3)

#logo
  @extend $logo-text
  font-size: logo-size
  line-height: logo-size
  letter-spacing: 2px
  font-size: 60px

#subtitle
  @extend $logo-text
  font-size: subtitle-size
  line-height: subtitle-size
  letter-spacing: 1px

#subtitle-wrap
  margin-top: subtitle-size

#main-nav
  float: left
  margin-left: -15px

$nav-link
  float: left
  color: #000000
  opacity: 0.6
  text-decoration: none
  text-shadow: 0 1px rgba(0, 0, 0, 0.2)
  transition: opacity 0.2s
  display: flex
  align-items: center
  justify-content: center
  height: 60px
  padding: 0 15px
  box-sizing: border-box
  &:hover
    opacity: 1

.nav-icon
  @extend $nav-link
  font-size: font-size
  width: 50px
  height: 60px
  padding: 0
  position: relative
  cursor: pointer
  
  span, i
    display: block
    line-height: 1

.main-nav-link
  @extend $nav-link
  font-weight: 300
  letter-spacing: 1px
  @media mq-mobile
    display: none

#main-nav-toggle
  display: none
  @media mq-mobile
    display: block

#sub-nav
  float: right
  margin-right: -15px

#search-form-wrap
  position: absolute
  top: 15px
  width: 150px
  height: 30px
  right: -150px
  opacity: 0
  transition: 0.2s ease-out
  &.on
    opacity: 1
    right: 0
  @media mq-mobile
    width: 100%
    right: -100%

.search-form
  position: absolute
  top: 0
  left: 0
  right: 0
  background: #fff
  padding: 5px 15px
  border-radius: 15px
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.3)

.search-form-input
  border: none
  background: none
  color: color-default
  width: 100%
  font: 13px font-sans
  outline: none
  &::-webkit-search-results-decoration
  &::-webkit-search-cancel-button
    -webkit-appearance: none

.search-form-submit
  position: absolute
  top: 50%
  right: 10px
  margin-top: -7px
  font: 13px font-icon
  border: none
  background: none
  color: #bbb
  cursor: pointer
  &:hover, &:focus
    color: #777