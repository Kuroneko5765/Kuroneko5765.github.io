// 自定义头图模糊效果
#banner
  position: relative
  overflow: hidden
  background: none
  min-height: 300px 
  
  .inner
    position: relative
    z-index: 2
    margin: 0 auto
    padding: 100px 30px
    text-align: center
    
  &::before
    content: ""
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    z-index: 1
    // 这里的路径写你实际的图片路径
    background-image: url("/images/TestBanner.png") 
    background-size: cover
    background-position: center
    background-repeat: no-repeat
    filter: blur(6px)
    transform: scale(1.05)
    transition: filter 0.6s ease, transform 0.6s ease
    
  &:hover::before
    filter: blur(0px)
    transform: scale(1)